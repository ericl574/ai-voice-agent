{
  "name": "ai-voice-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:hero": "node scripts/prepare-hero-video.mjs",
    "predev": "node scripts/prepare-hero-video.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-hero-video.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "qa:call-pipeline": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/qa-call-pipeline.ts",
    "qa:units": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/qa-units.ts",
    "qa:agent-evals": "tsx scripts/qa-agent-evals.ts",
    "qa:rag-quality": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/qa-rag-quality.ts",
    "knowledge:seed:auto-repair": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/seed-auto-repair-knowledge.ts",
    "voice:samples": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-voice-samples.ts",
    "pilot:map": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/map-business-number.ts",
    "pilot:approve": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/approve-pilot.ts",
    "twilio:bridge": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning server/twilio-bridge.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
