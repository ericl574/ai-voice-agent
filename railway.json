{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'FrontDesk bridge service — no build step; runs TS via node --experimental-strip-types'"
  },
  "deploy": {
    "startCommand": "npm run twilio:bridge",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
